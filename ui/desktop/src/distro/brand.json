    },
    {
      "label": "Medium",
      "model": "anthropic/claude-sonnet-5",
      "description": "Balanced. Best for most work."
    },
    {
      "label": "High",
      "model": "anthropic/claude-opus-5.5",
      "description": "Most capable. Complex documents and analysis."
    }
  ],
  "releases": {
    "githubOwner": "ADNAN-KIDZINK",
    "githubRepo": "Kidzink-AI"
  }
}
